LAB_ADDR=127.0.0.1:8080
LAB_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080
LAB_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Generate independent secrets, e.g. openssl rand -hex 32. Never use PUBLIC_ names.
LAB_BOT_TOKEN=replace-with-at-least-32-random-characters
LAB_METRICS_TOKEN=replace-with-an-independent-secret
LAB_SERVER_URL=http://127.0.0.1:8080
LAB_SUBMISSIONS_ENABLED=true
LAB_MAX_CLIENTS=200
LAB_MAX_IDENTITIES=2000
LAB_HISTORY_LIMIT=100
LAB_HISTORY_BYTES=1048576
LAB_HISTORY_SECONDS=900
LAB_QUEUE_SIZE=64
